# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

#
.ipynb_checkpoints
__pycache__
*.egg-info
.vscode/*
.idea/*
playground/
wandb/*
checkpoints/*
.ipynb_checkpoints/*
scripts/.ipynb_checkpoints/*
test/*
output/*

# Claude Code — ignore everything under .claude/
.claude/
.codex/

# ARCHS4 raw data — the ~58 GB source H5 and partial-download shards
# must never be committed; only the analysis outputs go into git.
eda/dataset/cvd_data/archs4/
human_gene_v2.latest.h5*.tmp
*.h5.tmp

# Intermediate normalized subsample cache (1.3 GB float32 matrix).
# Regenerable from the reference distribution + subsample indices.
eda/dataset/cvd_data/eda_out/normalized/subsample_matrix.npy

# Elastic-net training-pool expression matrix (6.4 GB float32).
# Regenerable via the load_expression stage of `python -m elasticnet.train`.
eda/dataset/cvd_data/elasticnet_out/expression/X.npy

# Gene-pool curation CVD-only expression matrix (~1.7 GB float32).
# Regenerable via `python -m gene_pool_prep.materialize_cvd_matrix`. The
# manifest and sample-index vector beside it are small and stay in git.
eda/dataset/cvd_data/gene_pool_prep/cvd_only_expression.npy

# Gene-pool curation prose reports (union summaries, screen findings, audits).
# Regenerable by re-running the stage that emits them, and they go stale the
# moment a ranking is recomputed. The manifests and CSVs beside them carry the
# same numbers in a form that does not drift. README.md is the module's
# hand-written entry point, not a generated report, so it stays tracked.
gene_pool_prep/**/*.md
!gene_pool_prep/README.md

# Superseded gene-pool run, kept locally for provenance only. These outputs
# were computed before the library-size filter landed, on 8,725 samples rather
# than 8,553, so they disagree with every tracked artifact by construction.
gene_pool_prep/prefix_sample_filter/

# BulkFormer third-party repo (~25 MB, includes its own .git). Users clone it
# themselves via `git clone https://github.com/KangBoming/BulkFormer.git bulkencoders/BulkFormer`.
bulkencoders/BulkFormer/

# Downloaded BulkFormer checkpoints + support tensors (~1.6 GB). Regenerable
# via `python -m bulkencoders.download`. The existing `checkpoints/*` rule
# above uses a single-level glob that misses nested files here.
bulkencoders/checkpoints/

# Linear-probe intermediates. Both are large and deterministic —
# regenerable from `linear_probe/labels.py` and `linear_probe/extract.py`.
linear_probe/embeddings/
linear_probe/*.parquet

# Smoke-test scratch dirs (regenerable by re-running the tests; large — the
# vicuna one holds a downloaded tokenizer + a reduced-depth Llama checkpoint).
integration/_smoke_tmp/
integration/_vicuna_smoke_tmp/
integration/_stage1_dryrun/

# QA-generation model input (653 MB float32, 8,553 x 20,010). Regenerable via
# `python -m qa_generation.build_bulkformer_matrix`, which calls
# linear_probe/extract.py::normalize_and_align — the single authoritative
# TPM -> log1p implementation. The manifest, sample index and symbol->ENSG map
# beside it are small and stay in git as the provenance record.
qa_generation/bulkformer_input/bulkformer_expression.npy

# Top-100 co-expression partners per pool gene. Regenerable via
# `python -m qa_generation.build_coexpression_edges`; its manifest stays tracked.
qa_generation/coexpression/coexpression_edges.parquet

# Sampling plan (33 MB) and every generated corpus (~590 MB of JSONL): filled
# pairs, DeepSeek request/response batches and pilot runs. Regenerable by
# re-running the pipeline, though the DeepSeek stages cost money to reproduce,
# so these are archived outside git rather than committed. The *_stats.json and
# *_report.md files beside them carry the same numbers and stay tracked.
qa_generation/generation_plan.json
qa_generation/*.jsonl

# Training bundle — the handoff tree. 8,553 per-sample .npy vectors (686 MB),
# rebuildable with `python -m qa_generation.materialize_npy`.
# The training JSONs have no producer script in this repo (the schema conversion
# was run ad hoc), so they are NOT regenerable from tracked code. Both stages are
# therefore committed, zipped, one archive per stage:
#   * stage1_train.zip  — 199,954 connector-alignment pairs (115 MB -> 26 MB)
#   * stage2_train.zip  —  19,793 instruction-tuning items  ( 11 MB ->  0.5 MB)
# Zipping is what makes stage 1 committable at all: the raw JSON is over GitHub's
# 100 MB per-file hard limit, the archive is well under it. Unzip in place before
# training — the launchers read the .json paths, not the archives.
# The raw .json files are ignored: the archives are the single tracked copy of
# each stage, so there is no duplicate to drift.
# materialization_manifest.json stays tracked as the provenance record.
data/cvd_transcriptome/embeddings/
data/cvd_transcriptome/text_files/*
!data/cvd_transcriptome/text_files/stage1_train.zip
!data/cvd_transcriptome/text_files/stage2_train.zip

# The training JSONs belong in data/cvd_transcriptome/text_files/, not at the
# repo root; this stops a stray copy landing in a commit if a converter is run.
/stage1_train.json
/stage2_train.json

# env file
 .env
.env
data.zip
integration/_stage2_lora_dryrun_tmp/

# Agent-generated status reports (dry-run results, hardware retunes, per-stage
# verifications). They are a working record of one run at one point in time, go
# stale as soon as the code they describe changes, and every number in them is
# reproducible by re-running the harness they name. Hand-written docs
# (llm_training_plan.md, README.md, writeup.md) are not reports and stay tracked.
# NOTE: reports committed before this rule landed remain tracked — .gitignore
# does not untrack, and removing them would drop history.
**/*_report.md
**/*_result.md
**/*_verification.md
